{
  "description": "Shared recurrence vectors for the TypeScript and Kotlin suites. Expected values were worked out by hand from the rules in docs/spec.md section 5. occurrencesBetween covers the half-open range [from, to). nextOccurrence returns the first instant strictly after 'after', or null. Wall-clock times that fall in a spring-forward gap move forward by the gap; times that occur twice in autumn use the earlier instant (java.time ofLocal defaults). Weekdays are Monday = 0.",
  "vectors": [
    {
      "name": "every 12 hours keeps exact 12h spacing across the Paris spring DST change",
      "tz": "Europe/Paris",
      "event": { "start_at": "2026-03-28T07:00:00Z", "repeat_unit": "hour", "repeat_interval": 12, "repeat_weekdays": null, "ends_at": null, "active": true },
      "from": "2026-03-28T00:00:00Z",
      "to": "2026-03-30T12:00:00Z",
      "expected": ["2026-03-28T07:00:00Z", "2026-03-28T19:00:00Z", "2026-03-29T07:00:00Z", "2026-03-29T19:00:00Z", "2026-03-30T07:00:00Z"],
      "next": [
        { "after": "2026-03-28T07:00:00Z", "expected": "2026-03-28T19:00:00Z" },
        { "after": "2026-03-29T07:00:00Z", "expected": "2026-03-29T19:00:00Z" }
      ]
    },
    {
      "name": "every 12 hours keeps exact 12h spacing across the Paris autumn DST change",
