<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
          Debug builds only (this file is in the debug source set): `adb shell am broadcast` seeds a test schedule.
          Exported, but only senders holding DUMP can reach it, which the adb shell has and ordinary apps do not.
        -->
        <receiver
            android:name="com.yassine.alarmcalendar.alarm.DebugSeedReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.yassine.alarmcalendar.debug.SEED" />
                <action android:name="com.yassine.alarmcalendar.debug.CLEAR" />
                <action android:name="com.yassine.alarmcalendar.debug.DUMP" />
                <action android:name="com.yassine.alarmcalendar.debug.CLOSE_SCREEN" />
                <action android:name="com.yassine.alarmcalendar.debug.PERMS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
