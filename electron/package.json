{
  "name": "@alarm-calendar/electron",
  "version": "0.1.0",
  "private": true,
  "productName": "Alarm Calendar",
  "description": "Electron main process: scheduler, alarm window, tray",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "node build.mjs && electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "generate-assets": "node scripts/generate-assets.mjs",
    "package": "node build.mjs && electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "@alarm-calendar/core": "workspace:*",
    "@electron/fuses": "^2.1.3",
    "@supabase/supabase-js": "^2.117.2",
    "@types/node": "^24.0.0",
    "electron": "^44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11",
    "zod": "^4.6.5"
  }
}
